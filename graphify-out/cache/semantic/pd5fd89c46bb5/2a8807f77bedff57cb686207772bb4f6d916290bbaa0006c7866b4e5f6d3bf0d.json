{"nodes": [{"id": "readme", "label": "README: Winter 2027 Internship Agent", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_human_in_the_loop", "label": "The agent never applies or sends on its own", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user reviews every message and sends it himself; applications are submitted by hand."}, {"id": "readme_fit_scoring", "label": "Fit score against the resume (0-100, reasons, talking points)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_startup_search", "label": "Search for recently funded startups (last 60 days; Canada, USA, Europe)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A result is kept only if its cited article loads and names both the company and the founder, to guard against invented URLs and misattributed founders."}, {"id": "readme_big_company_postings", "label": "Big-company postings from the SimplifyJobs off-season list", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marking a posting applied tops the open list back up to TARGET_OPEN_POSTINGS; applied or skipped postings are never re-added."}, {"id": "readme_learned_rules", "label": "Rules learned from notes (skip, downrank, boost)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A note such as 'this one needs French, not ap