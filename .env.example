# Set true for a Microsoft 365 work/school mailbox (e.g. uwaterloo.ca); false for Outlook.com.
OUTLOOK_ORG_MODE=false
TIMEZONE=America/Toronto
# Override if npx is not on PATH (use npx.cmd on Windows).
# OUTLOOK_MCP_COMMAND=npx.cmd
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
RESUME_PATH=../website/public/ModiAaravResume.pdf
# Dashboard email sending (Gmail app password, not your account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
TARGET_OPEN_POSTINGS=15
