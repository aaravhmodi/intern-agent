        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "6372fabb-31cc-5f53-a804-153f4f69af02",
      "name": "Find jobs and prepare materials",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERN_AGENT_URL }}/api/daily/run",
        "options": {
          "timeout": 900000
        }
      }
    }
  ],
  "connections": {
    "Every morning at 8": {
      "main": [
        [
          {
            "node": "Find jobs and prepare materials",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "notes": "Every morning at 8 AM America/Toronto, finds postings and prepares tailored answers and cover letters for open, non-Workday jobs. The tracker pushes counts to the configured ntfy topic. This workflow never submits applications."
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Toronto",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "tags": []
}
