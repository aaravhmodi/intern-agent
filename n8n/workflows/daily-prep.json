{
  "id": "7c4d8e74077c5df9",
  "name": "Internship tracker: daily job prep",
  "active": true,
  "nodes": [
    {
      "id": "9183f142-7160-5872-a706-8fdae5f06fb5",
      "name": "Every morning at 8",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
